---
import Figura from "./Figura.astro";
import {
  figuraDoTrabalho,
  imagemBruno,
  trabalhosOrdenados,
} from "../lib/midia";
const destaques = (await trabalhosOrdenados()).filter(
  (t) => t.data.destaque && t.data.atorOriginal,
);
const paineis = await Promise.all(
  destaques.map(async (t) => ({
    nome: t.data.personagem,
    credito: `${t.data.atorOriginal}, em ${t.data.titulo}`,
    figura: await figuraDoTrabalho(
      t.data.original ?? t.data.cartaz,
      `${t.data.atorOriginal} como ${t.data.personagem}, material oficial de ${t.data.titulo}`,
      1600,
    ),
  })),
);
paineis.push({
  nome: "Bruno Azevedo",
  credito: "A voz brasileira dos três",
  figura: await imagemBruno("encaixe"),
});
---

<section
  class="rostos"
  id="rostos"
  aria-labelledby="rostos-titulo"
  data-rostos
  data-paineis={paineis.length}
>
  <div class="rostos__palco">
    <div class="rostos__texto">
      <h2 id="rostos-titulo">Personagens</h2>
      <p class="rostos__voz">
        Atores de cinema que falam português com a voz do Bruno: na versão
        brasileira, a interpretação acompanha cada rosto.
      </p>
    </div>
    <ol class="rostos__paineis" role="list">
      {paineis.map((p, i) => (
        <li class="rostos__painel" data-rostos-painel data-indice={i}>
          <figure>
            <div class="rostos__quadro" data-rostos-quadro>
              <Figura
                figura={p.figura}
                sizes="(max-width:760px) 89vw, 49vw"
                cedo
              />
            </div>
            <figcaption class="rostos__legenda">
              <span class="rostos__nome">{p.nome}</span>
              <span class="rostos__credito">{p.credito}</span>
            </figcaption>
          </figure>
        </li>
      ))}
    </ol>
    <a class="rostos__proximo acao" href="#trabalhos">
      Ver todos os trabalhos
      <svg
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.5"
        aria-hidden="true"
      >
        <path d="m6 9 6 6 6-6" />
      </svg>
    </a>
  </div>
</section>
<style>
  .rostos {
    position: relative;
    padding: var(--section-gap) var(--margin);
    background: var(--bg);
  }
  .rostos__palco {
    position: relative;
  }
  .rostos__texto {
    display: flex;
    justify-content: space-between;
    align-items: end;
    gap: 2rem;
    margin-bottom: 3rem;
  }
  .rostos h2 {
    font-size: clamp(3.5rem, 7.7vw, 8.5rem);
    line-height: 0.94;
    font-weight: 300;
    letter-spacing: -0.055em;
  }
  .rostos__voz {
    max-width: 26rem;
    font-size: 1.125rem;
    line-height: 1.5;
    color: var(--muted);
  }
  .rostos__paineis {
    padding: 0;
    list-style: none;
    display: grid;
    gap: 4rem;
  }
  .rostos__painel {
    min-width: 0;
  }
  /* O quadro tem a proporção dos retratos (4:5): o rosto aparece inteiro, sem
     o corte de um quadro quase quadrado. A legenda acompanha a largura dele. */
  .rostos__painel figure {
    width: fit-content;
    max-width: 100%;
    margin-inline: auto;
  }
  .rostos__quadro {
    overflow: clip;
    height: 70svh;
    aspect-ratio: 4 / 5;
    max-width: 100%;
    background: var(--surface);
  }
  .rostos__quadro :global(.figura) {
    object-position: center 40%;
  }
  .rostos__legenda {
    display: flex;
    justify-content: space-between;
    gap: 1.5rem;
    padding-top: 1.15rem;
  }
  .rostos__nome {
    font-size: var(--step-lead);
  }
  .rostos__credito {
    font-size: var(--step-small);
    color: var(--muted);
    text-align: right;
  }
  .rostos__proximo {
    margin-top: 2rem;
  }
  @media (prefers-reduced-motion: no-preference) {
    :global(html.js:not(.sem-movimento)) .rostos {
      height: 330svh;
      padding: 0 var(--margin);
    }
    :global(html.js:not(.sem-movimento)) .rostos__palco {
      position: sticky;
      top: 0;
      height: 100svh;
      display: grid;
      grid-template-columns: 1fr 1.25fr;
      gap: var(--gutter);
      align-items: center;
      padding-block: 4.5svh;
    }
    :global(html.js:not(.sem-movimento)) .rostos__texto {
      align-self: stretch;
      flex-direction: column;
      align-items: start;
      justify-content: space-between;
      margin: 0;
      padding-block: 3svh 9svh;
    }
    :global(html.js:not(.sem-movimento)) .rostos__paineis {
      position: relative;
      height: 100%;
    }
    :global(html.js:not(.sem-movimento)) .rostos__painel {
      position: absolute;
      inset: 0;
    }
    :global(html.js:not(.sem-movimento)) .rostos__painel:not(:first-child) {
      visibility: hidden;
    }
    :global(html.js:not(.sem-movimento)) .rostos__quadro {
      height: 76svh;
    }
    :global(html.js:not(.sem-movimento)) .rostos__proximo {
      position: absolute;
      left: 0;
      bottom: 3svh;
      margin: 0;
    }
  }
  @media (max-width: 760px) {
    .rostos {
      padding-block: 4.5rem;
    }
    .rostos__texto {
      align-items: start;
      gap: 1rem;
    }
    .rostos h2 {
      font-size: 14vw;
    }
    .rostos__voz {
      font-size: 1rem;
    }
    .rostos__quadro {
      height: 53svh;
    }
    .rostos__nome {
      font-size: 1.125rem;
    }
    .rostos__credito {
      font-size: 0.8125rem;
      max-width: 48%;
    }
    :global(html.js:not(.sem-movimento)) .rostos {
      height: 255svh;
    }
    :global(html.js:not(.sem-movimento)) .rostos__palco {
      display: block;
      padding-block: 1.6rem;
    }
    :global(html.js:not(.sem-movimento)) .rostos__texto {
      flex-direction: column;
      padding: 0;
      margin-bottom: 1.25rem;
      gap: 0.6rem;
    }
    :global(html.js:not(.sem-movimento)) .rostos__paineis {
      height: 66svh;
    }
    :global(html.js:not(.sem-movimento)) .rostos__quadro {
      height: 55svh;
    }
    :global(html.js:not(.sem-movimento)) .rostos__proximo {
      bottom: 1.25rem;
    }
  }
</style>
