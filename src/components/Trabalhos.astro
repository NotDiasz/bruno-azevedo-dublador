---
import VersaoBrasileira, { type ItemVersao } from "./VersaoBrasileira";
import {
  figuraDoTrabalho,
  imagemBruno,
  legendaCartaz,
  trabalhosOrdenados,
} from "../lib/midia";
import { tipos } from "../data/site";
const trabalhos = await trabalhosOrdenados();
const bruno = await imagemBruno("encaixe");
const itens: ItemVersao[] = await Promise.all(
  trabalhos.map(async (t) => ({
    id: t.id,
    titulo: t.data.titulo,
    personagem: t.data.personagem,
    atorOriginal: t.data.atorOriginal ?? null,
    obra: [tipos[t.data.tipo], t.data.titulo, t.data.ano]
      .filter(Boolean)
      .join(", "),
    cartaz: t.data.original
      ? await figuraDoTrabalho(t.data.cartaz, legendaCartaz(t), 1400)
      : bruno,
    original: t.data.original
      ? await figuraDoTrabalho(
          t.data.original,
          `${t.data.atorOriginal} como ${t.data.personagem}, material oficial de ${t.data.titulo}`,
          1400,
        )
      : null,
    exemplo: t.data.exemplo,
  })),
);
---

<section
  class="trabalhos"
  id="trabalhos"
  aria-labelledby="trabalhos-titulo"
  data-trabalhos
>
  <div class="trabalhos__abertura">
    <h2 id="trabalhos-titulo" data-entra>
      Trabalhos
    </h2>
    <a class="acao" href="/trabalhos/">
      Ver filmografia completa
      <svg
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.5"
        aria-hidden="true"
      >
        <path d="M5 19 19 5M5 5h14v14" />
      </svg>
    </a>
  </div>
  <div class="trabalhos__corpo">
    <ol class="trabalhos__nomes" role="list">
      {trabalhos.map((t, i) => (
        <li class="trabalhos__linha">
          <a
            class="trabalhos__nome"
            href={`/trabalhos/#${t.id}`}
            data-trabalho-nome={i}
            data-entra
          >
            {t.data.personagem}
          </a>
          <span class="trabalhos__obra">{t.data.titulo}</span>
        </li>
      ))}
    </ol>
    <div class="trabalhos__palco">
      <VersaoBrasileira client:visible itens={itens} bruno={bruno} />
      <p class="trabalhos__instrucao">
        Arraste a divisa para comparar o original com a versão brasileira.
      </p>
    </div>
  </div>
</section>
<style>
  .trabalhos {
    padding: var(--section-gap) var(--margin);
    background: var(--surface);
  }
  .trabalhos__abertura {
    display: flex;
    justify-content: space-between;
    align-items: end;
    gap: 2rem;
    margin-bottom: 5rem;
  }
  .trabalhos h2 {
    font-size: clamp(3.5rem, 7.7vw, 8.5rem);
    line-height: 0.94;
    font-weight: 300;
    letter-spacing: -0.055em;
  }
  .trabalhos__abertura .acao {
    margin-bottom: 0.5rem;
    font-size: 1rem;
  }
  .trabalhos__corpo {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: clamp(2rem, 6vw, 6rem);
    align-items: start;
  }
  .trabalhos__nomes {
    padding: 0;
    list-style: none;
  }
  .trabalhos__linha {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 1.2rem;
    min-height: 36svh;
    padding-block: 2rem;
  }
  .trabalhos__nome {
    display: block;
    font-size: clamp(3.5rem, 6.4vw, 7rem);
    font-weight: 300;
    line-height: 0.98;
    letter-spacing: -0.055em;
    text-decoration: none;
    transition: opacity 0.2s ease;
  }
  .trabalhos__obra {
    color: var(--muted);
    font-size: 1rem;
  }
  .trabalhos__nome:hover {
    opacity: 0.65;
  }
  .trabalhos__palco {
    position: sticky;
    top: 6svh;
    padding-top: 2rem;
  }
  .trabalhos__instrucao {
    margin-top: 1rem;
    font-size: 0.875rem;
    color: var(--muted);
  }
  .trabalhos :global(.vb) {
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: start;
    gap: 1.15rem;
  }
  .trabalhos :global(.vb__quadro) {
    grid-column: 1/-1;
    position: relative;
    /* 4:5, a proporção dos retratos: o quadro mostra o recorte inteiro, sem
       zoom, e as duas metades se alinham pixel a pixel. Limitado em altura
       para caber na tela junto com os créditos. */
    width: min(100%, 52svh);
    justify-self: center;
    aspect-ratio: 4 / 5;
    overflow: clip;
    background: var(--bg);
  }
  .trabalhos :global(.vb__camada) {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 0.35s ease;
  }
  .trabalhos :global(.vb__camada[data-ativa]) {
    opacity: 1;
  }
  .trabalhos :global(.vb__camada .figura) {
    position: absolute;
    inset: 0;
    object-position: 50% 50%;
  }
  .trabalhos :global(.vb__original) {
    position: absolute;
    inset: 0;
    clip-path: inset(0 calc(100% - var(--divisa)) 0 0);
  }
  .trabalhos :global(.vb__veu) {
    display: none;
  }
  .trabalhos :global(.vb__linha) {
    position: absolute;
    top: 0;
    bottom: 0;
    left: var(--divisa);
    width: 3px;
    margin-left: -1.5px;
    background: var(--ink);
    pointer-events: none;
  }
  .trabalhos :global(.vb__controle) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    margin: 0;
    background: transparent;
    cursor: ew-resize;
    appearance: none;
    -webkit-appearance: none;
    touch-action: pan-y;
  }
  .trabalhos :global(.vb__controle::-webkit-slider-runnable-track) {
    height: 100%;
    background: transparent;
  }
  .trabalhos :global(.vb__controle::-moz-range-track) {
    height: 100%;
    background: transparent;
  }
  .trabalhos :global(.vb__controle::-webkit-slider-thumb) {
    -webkit-appearance: none;
    width: 3.25rem;
    height: 3.25rem;
    margin-top: calc((100% - 3.25rem) / 2);
    border: 0;
    border-radius: 50%;
    background: var(--ink);
  }
  .trabalhos :global(.vb__controle::-moz-range-thumb) {
    width: 3.25rem;
    height: 3.25rem;
    border: 0;
    border-radius: 50%;
    background: var(--ink);
  }
  .trabalhos :global(.vb__controle:focus-visible) {
    outline: 3px solid var(--ink);
    outline-offset: -7px;
  }
  .trabalhos :global(.vb__credito) {
    display: grid;
    gap: 0.3rem;
    min-height: 3.25rem;
    padding: 0;
    border: 0;
    background: none;
    color: var(--ink);
    font: inherit;
    font-size: 1rem;
    line-height: 1.2;
    text-align: left;
  }
  .trabalhos :global(button.vb__credito) {
    cursor: pointer;
  }
  .trabalhos :global(.vb__credito--versao) {
    text-align: right;
  }
  .trabalhos :global(.vb__papel) {
    font-size: 0.875rem;
    color: var(--muted);
  }
  .trabalhos :global(.vb__quem) {
    font-weight: 500;
  }
  .trabalhos :global(.vb__obra) {
    grid-column: 1/-1;
    color: var(--muted);
    font-size: 0.875rem;
  }
  .trabalhos :global(.vb__selecionar) {
    grid-column: 1/-1;
    display: grid;
    gap: 0.5rem;
    font-size: 0.875rem;
  }
  .trabalhos :global(.vb__selecionar select) {
    width: 100%;
    border: 0;
    padding: 0.8rem;
    min-height: 3rem;
    background: var(--bg);
    color: var(--ink);
    border-radius: 0;
  }
  @media (max-width: 760px) {
    .trabalhos {
      padding-block: 4.5rem;
    }
    .trabalhos__abertura {
      display: grid;
      gap: 1rem;
      margin-bottom: 2rem;
    }
    .trabalhos h2 {
      font-size: 14vw;
    }
    .trabalhos__corpo {
      display: flex;
      flex-direction: column-reverse;
      gap: 2rem;
    }
    .trabalhos__palco {
      position: relative;
      top: auto;
      padding: 0;
      width: 100%;
    }
    .trabalhos__nomes {
      width: 100%;
    }
    .trabalhos__linha {
      min-height: 0;
      padding-block: 1.75rem;
      gap: 0.6rem;
    }
    .trabalhos__nome {
      font-size: 14vw;
      max-width: 100%;
    }
    .trabalhos__obra {
      font-size: 1rem;
    }
    .trabalhos :global(.vb__quadro) {
      width: min(100%, 60svh);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .trabalhos__palco {
      position: relative;
      top: auto;
    }
    .trabalhos :global(.vb__camada) {
      transition: none;
    }
  }
</style>
